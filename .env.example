# Copy this file to .env and fill in the tunnel token.
#
# Where to find it:
#   Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
#   -> create/open your tunnel -> "Install connector" -> copy the token.
#
# Never commit the real .env file: it is ignored by git.
CLOUDFLARE_TUNNEL_TOKEN=replace-me-with-your-tunnel-token
